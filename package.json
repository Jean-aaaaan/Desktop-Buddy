{
  "name": "desktop-buddy",
  "version": "1.0.0",
  "description": "Your pixelated desktop companion",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "dependencies": {
    "electron": "^28.0.0",
    "googleapis": "^140.0.0"
  },
  "devDependencies": {
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.desktopbuddy.app",
    "productName": "Desktop Buddy",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "add-quote.html",
      "quote-manager.html",
      "calendar.js",
      "quotes.json",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
